{
  "info": { "name": "SAGE M16 notifications", "description": "Expected examples only; run manually with two users. Socket.IO checklist: docs/api/M16-notifications.md", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }, { "key": "accessToken", "value": "" }, { "key": "notificationId", "value": "11111111-1111-4111-8111-111111111111" }],
  "item": [
    { "name": "List my notifications", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/notifications?page=1&limit=20" }, "response": [] },
    { "name": "Mark my notification read", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/api/v1/notifications/{{notificationId}}/read" }, "response": [] },
    { "name": "List without credentials (401)", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/notifications" }, "response": [] }
  ]
}
