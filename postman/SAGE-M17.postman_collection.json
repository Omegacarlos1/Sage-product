{
  "info": { "name": "SAGE M17 security cases", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }, { "key": "learnerAccessToken", "value": "" }, { "key": "adminAccessToken", "value": "" }],
  "item": [
    { "name": "CORS allowed health", "request": { "method": "GET", "header": [{ "key": "Origin", "value": "https://sage.example.test" }], "url": "{{baseUrl}}/api/v1/health" } },
    { "name": "CORS denied health", "request": { "method": "GET", "header": [{ "key": "Origin", "value": "https://evil.example.test" }], "url": "{{baseUrl}}/api/v1/health" } },
    { "name": "Invalid login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"missing@example.test\",\"password\":\"wrong\"}" }, "url": "{{baseUrl}}/api/v1/auth/login" } },
    { "name": "Admin no token", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/auth/admin-check" } },
    { "name": "Admin learner token", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{learnerAccessToken}}" }], "url": "{{baseUrl}}/api/v1/auth/admin-check" } },
    { "name": "Admin admin token", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "url": "{{baseUrl}}/api/v1/auth/admin-check" } },
    { "name": "Contact abuse sample", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Test\",\"email\":\"test@example.test\",\"subject\":\"Hello\",\"message\":\"Please respond\"}" }, "url": "{{baseUrl}}/api/v1/contact" } },
    { "name": "Newsletter abuse sample", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"test@example.test\"}" }, "url": "{{baseUrl}}/api/v1/newsletter/subscribe" } }
  ]
}
