{
  "name": "sage-lms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SAGE LMS API backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run build && jest --runInBand tests/unit",
    "test:integration": "npm run build && mocha \"tests/integration/**/*.test.js\"",
    "test:runtime": "node tests/runtime-smoke.js",
    "ci": "npm run lint && npm run typecheck && npm test && npm run test:runtime"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "mocha": "^11.7.5",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
